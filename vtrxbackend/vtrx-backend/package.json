{
  "name": "vtrx-backend",
  "version": "2.0.0",
  "description": "VTRX Fitness Platform - Production Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "npx prisma generate && npx prisma db push --accept-data-loss",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "seed:recipes": "node scripts/seedRecipes.js",
    "seed:exercises": "node scripts/seedExerciseLibrary.js",
    "test:ai-plan": "node scripts/testAIPlanGenerator.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.14",
    "@supabase/supabase-js": "^2.45.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@prisma/client": "^5.16.0",
    "@sentry/node": "^10.57.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "openai": "^4.52.0",
    "resend": "^6.12.4",
    "stripe": "^16.2.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.16.0"
  }
}
