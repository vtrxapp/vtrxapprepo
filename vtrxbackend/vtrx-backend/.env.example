# ─────────────────────────────────────────────────────────────────────────────
# VTRX Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local dev. In production, set these in your host's
# dashboard (Railway/Render/etc.) — never commit real values.
#
# This backend is a long-running Node process (Express + an in-process
# node-cron scheduler for notifications, plus one-time sync jobs that run at
# boot) — it needs a host that keeps a process alive, not a serverless one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Direct (non-pooled) connection used ONLY for schema migrations (prisma
# generate/db push/migrate — see postinstall). If your DATABASE_URL goes
# through a connection pooler (Supabase Supavisor, PgBouncer, etc.), point
# this at the same database's direct connection string instead — Supabase:
# Project Settings → Database → Connection string → "Direct connection".
# Required once schema.prisma declares directUrl — every `prisma` command
# fails immediately if this is unset while that's declared.
DIRECT_URL=postgresql://user:password@host:5432/dbname
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact URL of the deployed frontend — required in production, or every
# browser request will fail CORS (see server.js's boot-time check).
FRONTEND_URL=https://your-frontend.example.com
# Optional: comma-separated list of additional exact-match Vercel origins
# (e.g. a staging deployment). There is no wildcard *.vercel.app match.
ALLOWED_VERCEL_ORIGINS=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ── AI ────────────────────────────────────────────────────────────────────────
# Anthropic powers all plan generation and coaching copy. OpenAI is used for
# exactly one thing — text-embedding-3-small, to build the Pinecone vectors
# behind recommendation search — nothing else in this app calls OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=

# ── Third-party content/fitness data ────────────────────────────────────────
YMOVE_API_URL=https://exercise-api.ymove.app/api/v2
YMOVE_API_KEY=

# ── Storage (Supabase) ───────────────────────────────────────────────────────
# Used for progress-photo/avatar uploads only — this is not the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# Base64-encoded Firebase service account JSON. Without this, push
# notifications are silently disabled (logged, not fatal).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Webhooks / automation — inbound ─────────────────────────────────────────
# Shared secret n8n sends as the X-N8N-Secret header on its callbacks.
N8N_WEBHOOK_SECRET=
# Linear's webhook signing secret (Linear project settings → Webhooks).
LINEAR_WEBHOOK_SECRET=

# ── Webhooks — outbound (Make.com automations) ──────────────────────────────
MAKE_WEBHOOK_USER_SIGNUP=
MAKE_WEBHOOK_SUBSCRIPTION=
MAKE_WEBHOOK_WORKOUT_COMPLETE=
MAKE_WEBHOOK_SENTRY=

# ── Admin-gated endpoints ────────────────────────────────────────────────────
# Comma-separated list of user IDs allowed to call admin-only routes (recipe
# sync trigger, etc.), and/or a shared secret header as an alternative.
ADMIN_USER_IDS=
ADMIN_SECRET=
