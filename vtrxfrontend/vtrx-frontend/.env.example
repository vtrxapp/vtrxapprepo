# ─────────────────────────────────────────────────────────────────────────────
# VTRX Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local dev, or set in your host's dashboard (Vercel
# → Project → Settings → Environment Variables) for deployed environments.
#
# Only VITE_* prefixed variables are included in the browser bundle — never
# put a secret key here. Everything below is a client-safe publishable/
# public key by design.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_CLERK_PUBLISHABLE_KEY=

# ── Payments ─────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Observability / analytics (optional — app runs fine without these) ─────
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Push notifications (optional — Firebase Cloud Messaging web push) ──────
VITE_FIREBASE_VAPID_KEY=

# ── Cosmetic / optional, all default sensibly if unset ──────────────────────
VITE_APP_NAME=VTRX
VITE_APP_ENV=development
VITE_CDN_URL=
